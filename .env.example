# ==============================================================================
# TravelPulse LK — Root Environment Configuration Template
# Group 10 (SE5104 Mini Project)
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development # Set to 'production' in production deployments

# MySQL 8.0 Database (Docker Compose or Local Instance)
DB_HOST=mysql
DB_PORT=3306
DB_USER=travelpulse
DB_PASSWORD=travelpulse_pass
DB_NAME=travelpulse_lk
MYSQL_ROOT_PASSWORD=travelpulse_root_pass

# Security & Session Secrets
# IMPORTANT: In production, generate a strong random 256-bit secret (e.g. `openssl rand -hex 32`).
# The server will strictly FAIL TO START in production if JWT_SECRET is not configured or empty.
JWT_SECRET=travelpulse_development_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Mobile Client API Base URL
# - Android Emulator: http://10.0.2.2:5000/api/v1
# - iOS Simulator / Desktop / Web: http://localhost:5000/api/v1
# - Physical Device: http://<YOUR_LAN_IP>:5000/api/v1
TRAVELPULSE_API_BASE_URL=http://10.0.2.2:5000/api/v1


